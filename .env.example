# Reference only: the app reads PROCESS environment variables; it does not auto-load .env.
# Default is a limited offline demonstration. No key is needed for mock.
COPILOT_LLM_PROVIDER=mock
ACADEMIC_DB_PATH=data/agent-demo.sqlite3
# Workbench launch scripts use data/workbench-demo.sqlite3 to create enriched
# synthetic major/course-type metadata without overwriting the Phase 2A database.
# Frontend only; no LLM credential is needed in the Streamlit terminal.
COPILOT_API_BASE_URL=http://127.0.0.1:8000

# Set COPILOT_LLM_PROVIDER=deepseek in the service terminal for hosted inference.
# Enter the real key in that terminal through a masked prompt.
COPILOT_LLM_MODEL=deepseek-flash
COPILOT_LLM_API_KEY=
COPILOT_LLM_BASE_URL=https://api.deepseek.com
COPILOT_LLM_TIMEOUT_SECONDS=15
COPILOT_AGENT_TIMEOUT_SECONDS=45
# Remote strict mode applies to the OpenAI-compatible profile. Local validation is strict in every mode.
COPILOT_LLM_STRICT_TOOLS=true
